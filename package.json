{
  "name": "smd-gui",
  "version": "1.0.0",
  "description": "",
  "main": "./src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "author": "vortique",
  "license": "MIT",
  "build": {
    "appId": "com.vortique.smd-gui",
    "productName": "SMD GUI",
    "asar": true,
    "asarUnpack": [
      "**/ffmpeg-static-electron/bin/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "binaries/",
        "to": "binaries",
        "filter": "**/*"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "type": "module",
  "devDependencies": {
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "ffmpeg-static-electron": "^2.0.3",
    "p-limit": "^7.2.0"
  }
}
